# Production Environment Variables for Frontend
# This will be used when deploying to Vercel

# Backend API URL - Leave empty for Vercel deployment (uses same domain)
# Frontend and backend are both on Vercel, so API routes are relative
VITE_API_URL=

# Gemini API Key (set this in Vercel dashboard as environment variable)
# Note: This will be used by serverless functions
# Do NOT set this here - set it in Vercel dashboard for security
# GEMINI_API_KEY will be available to serverless functions automatically
